# ==========================================
# CONFIGURAÇÕES GERAIS
# ==========================================
# Sufixo adicionado ao arquivo final.
OUTPUT_SUFFIX=_DUB
# Taxa de amostragem de áudio (padrão 44100 ou 48000)
AUDIO_SAMPLE_RATE=44100
# Ajustes de paralelismo em CPU
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false

# ==========================================
# FASE 2: TRANSCRIÇÃO (Whisper)
# ==========================================
# Tamanhos: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL_SIZE=small
# Idioma original do vídeo (ex: en, es, fr)
WHISPER_SOURCE_LANG=en
# Precisão de computação (float16 para GPU, int8 para CPU/menor consumo)
WHISPER_COMPUTE_TYPE=int8
# Tamanho do feixe de busca (maior = mais preciso, mas mais lento)
WHISPER_BEAM_SIZE=2

# ==========================================
# FASE 3: TRADUÇÃO (MarianMT / HuggingFace)
# ==========================================
# Modelo de tradução (perfil CPU mais leve)
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-tc-big-en-pt 
# Tamanho do lote (reduza se tiver pouca VRAM, ex: 8 ou 16)
TRANSLATION_BATCH_SIZE=8

# ==========================================
# FASE 4: SÍNTESE DE VOZ (Edge-TTS)
# ==========================================
# Voz do narrador (ex: pt-BR-AntonioNeural, pt-BR-FranciscaNeural)
TTS_VOICE=pt-BR-AntonioNeural
# Número de threads simultâneas para gerar áudio
TTS_MAX_WORKERS=3

# ==========================================
# FASE 5: MIXAGEM DE ÁUDIO (FFmpeg Ducking)
# ==========================================
# Sensibilidade de disparo do ducking
DUCKING_THRESHOLD=0.05
# Intensidade da redução da trilha original quando há voz
DUCKING_RATIO=5
# Tempo de ataque (ms)
DUCKING_ATTACK=20
# Tempo de release (ms)
DUCKING_RELEASE=200
